# Release signing template.
# Copy this file to "keystore.properties" and fill in your own values to build a
# signed release APK. Both "keystore.properties" and the .jks keystore are gitignored
# on purpose and must NEVER be committed.
#
# Create a keystore with:
#   keytool -genkeypair -v -keystore app/splash-release.jks -alias splash \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# If this file is absent, the app still builds (debug, and an unsigned release).

storeFile=splash-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
